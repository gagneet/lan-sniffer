<Window x:Class="LanInspector.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanInspector"
        Width="1320"
        Height="780"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F4F6F8">
        <Border DockPanel.Dock="Top"
                Background="#18212B"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="LanInspector"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#B7C4D1"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Packets"
                               Foreground="#B7C4D1"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PacketCount}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Devices"
                               Foreground="#B7C4D1"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Devices.Count}"
                               Foreground="White"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#D9E0E7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                        <TextBlock Text="Capture interface"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Interfaces}"
                                  SelectedItem="{Binding SelectedInterface}"
                                  DisplayMemberPath="Description"
                                  IsEnabled="{Binding IsNotCapturing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Preset"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding BpfFilterPresets}"
                                  SelectedItem="{Binding SelectedBpfFilterPreset}"
                                  DisplayMemberPath="DisplayText"
                                  IsEnabled="{Binding IsNotCapturing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">
                        <TextBlock Text="BPF filter"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding CaptureFilter, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotCapturing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Refresh"
                                Command="{Binding RefreshInterfacesCommand}"
                                IsEnabled="{Binding IsNotCapturing}" />
                        <Button Content="Start"
                                Command="{Binding StartCaptureCommand}" />
                        <Button Content="Stop"
                                Command="{Binding StopCaptureCommand}" />
                        <Button Content="Clear"
                                Command="{Binding ClearResultsCommand}" />
                        <Button Content="Scan Ports"
                                Command="{Binding ScanSelectedPortsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        BorderBrush="#D9E0E7"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,14,0">
                    <DataGrid ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Display name"
                                                Binding="{Binding DisplayName}"
                                                Width="190" />
                            <DataGridTextColumn Header="IP addresses"
                                                Binding="{Binding IpAddresses}"
                                                Width="190" />
                            <DataGridTextColumn Header="MAC address"
                                                Binding="{Binding MacAddress}"
                                                Width="160" />
                            <DataGridTextColumn Header="Vendor"
                                                Binding="{Binding Vendor}"
                                                Width="170" />
                            <DataGridTextColumn Header="Hostname"
                                                Binding="{Binding Hostname}"
                                                Width="180" />
                            <DataGridTextColumn Header="DHCP class"
                                                Binding="{Binding DhcpVendorClass}"
                                                Width="150" />
                            <DataGridTextColumn Header="Open ports"
                                                Binding="{Binding OpenPorts}"
                                                Width="170" />
                            <DataGridTextColumn Header="Seen via"
                                                Binding="{Binding SeenVia}"
                                                Width="160" />
                            <DataGridTextColumn Header="Last seen"
                                                Binding="{Binding LastSeenLocal}"
                                                Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#D9E0E7"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Run history"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding RunHistory}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E3E8EE"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Summary}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CapturedAtLocal}"
                                                       Foreground="#5C6A78"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding DevicePreview}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#304050"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Filter}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#7A8794"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
