<Window x:Class="LanInspector.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanInspector"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F4F6F8">
        <Border DockPanel.Dock="Top"
                Background="#18212B"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="LanInspector"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#B7C4D1"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Packets"
                               Foreground="#B7C4D1"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PacketCount}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Devices"
                               Foreground="#B7C4D1"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Devices.Count}"
                               Foreground="White"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#D9E0E7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                        <TextBlock Text="Capture interface"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Interfaces}"
                                  SelectedItem="{Binding SelectedInterface}"
                                  DisplayMemberPath="Description"
                                  IsEnabled="{Binding IsNotCapturing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="BPF filter"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding CaptureFilter, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNotCapturing}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Content="Refresh"
                                Command="{Binding RefreshInterfacesCommand}"
                                IsEnabled="{Binding IsNotCapturing}" />
                        <Button Content="Start"
                                Command="{Binding StartCaptureCommand}" />
                        <Button Content="Stop"
                                Command="{Binding StopCaptureCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#D9E0E7"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding Devices}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MAC address"
                                            Binding="{Binding MacAddress}"
                                            Width="180" />
                        <DataGridTextColumn Header="IP addresses"
                                            Binding="{Binding IpAddresses}"
                                            Width="*" />
                        <DataGridTextColumn Header="Hostname"
                                            Binding="{Binding Hostname}"
                                            Width="180" />
                        <DataGridTextColumn Header="Vendor"
                                            Binding="{Binding Vendor}"
                                            Width="180" />
                        <DataGridTextColumn Header="First seen"
                                            Binding="{Binding FirstSeenLocal}"
                                            Width="150" />
                        <DataGridTextColumn Header="Last seen"
                                            Binding="{Binding LastSeenLocal}"
                                            Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
