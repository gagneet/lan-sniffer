<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\laninspector.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resource (not Content) so the window icon and header art are embedded in the single-file
         executable rather than needing to sit next to it. -->
    <Resource Include="Assets\laninspector.ico" />
    <Resource Include="Assets\laninspector-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanInspector.Core\LanInspector.Core.csproj" />
    <ProjectReference Include="..\LanInspector.Platform.Windows\LanInspector.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\oui.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\known-devices.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\known-devices.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\known-devices.local.json" Condition="Exists('Data\known-devices.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
