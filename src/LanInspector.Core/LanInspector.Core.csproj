<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests inject a fake process runner into ArpTableReader instead of shelling out. -->
    <InternalsVisibleTo Include="LanInspector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied beside the executable, so a published single-file build is
         genuinely one portable file. Copying only the .exe used to leave vendor lookup silently
         returning nothing, because its data was in a folder left behind. -->
    <EmbeddedResource Include="Data\oui.csv" />
    <EmbeddedResource Include="Data\known-devices.example.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
